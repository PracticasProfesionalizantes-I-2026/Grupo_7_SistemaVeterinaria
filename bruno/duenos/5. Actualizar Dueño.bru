meta {
  name: 5. Actualizar Dueño
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/duenos/{{duenoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "nombre": "Carlos Alberto",
    "apellido": "González",
    "dni": "34567890",
    "telefono": "11-4567-9999",
    "email": "carlos.nuevo@example.com",
    "direccion": "Av. Corrientes 4500"
  }
}
