meta {
  name: 1. Generar Reporte Integral (201 Created - Administrador)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/reportes/generar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdministrador}}
}

body:json {
  {
    "motivo": "Auditoría integral mensual de operaciones clínicas y comerciales",
    "tiposReporte": [
      "Atenciones",
      "Vacunaciones",
      "Mascotas",
      "Duenos",
      "Turnos"
    ],
    "fechaDesde": "2025-01-01T00:00:00Z",
    "fechaHasta": "2026-03-31T23:59:59Z"
  }
}

script:post-response {
  const respuesta = res.getBody();
  if (respuesta && respuesta.id) {
    bru.setEnvVar("reporteId", respuesta.id);
  }
}
