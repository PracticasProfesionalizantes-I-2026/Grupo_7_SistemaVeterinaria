meta {
  name: 8. Listar Historial de Reportes (200 OK - Administrador)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/reportes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdministrador}}
}

script:post-response {
  const reportes = res.getBody();
  if (Array.isArray(reportes) && reportes.length > 0) {
    bru.setEnvVar("reporteId", reportes[0].id);
  }
}
