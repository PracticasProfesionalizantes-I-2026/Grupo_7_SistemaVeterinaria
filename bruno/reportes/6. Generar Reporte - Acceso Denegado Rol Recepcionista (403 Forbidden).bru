meta {
  name: 6. Generar Reporte - Acceso Denegado Rol Recepcionista (403 Forbidden)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/reportes/generar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{recepToken}}
}

