meta {
  name: 7. Crear Turno - Fuera de Disponibilidad Profesional (409 Conflict - RN-10)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "{{fechaTurnoFueraDisp}}",
    "motivoConsulta": "Intento de turno en domingo o madrugada fuera de agenda"
  }
}

script:pre-request {
  // Próximo domingo a las 03:00 UTC (fuera de toda disponibilidad profesional)
  const ahora = new Date();
  const proximo = new Date(ahora.getTime());
  const diasHastaDomingo = (7 - ahora.getDay()) % 7 || 7;
  proximo.setDate(ahora.getDate() + diasHastaDomingo);
  proximo.setUTCHours(3, 0, 0, 0);
  bru.setEnvVar("fechaTurnoFueraDisp", proximo.toISOString());
}
