meta {
  name: 6. Crear Turno - Mascota Inactiva (409 Conflict - RN-07)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "mascotaId": "{{mascotaInactivaId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "{{fechaTurnoValido}}",
    "motivoConsulta": "Intento de agendar turno a paciente con baja lÃ³gica"
  }
}

script:pre-request {
  const ahora = new Date();
  const proximo = new Date(ahora.getTime());
  const diasHastaLunes = ((1 - ahora.getDay() + 7) % 7) || 7;
  proximo.setDate(ahora.getDate() + diasHastaLunes);
  proximo.setUTCHours(11, 30, 0, 0);
  bru.setEnvVar("fechaTurnoValido", proximo.toISOString());
}
