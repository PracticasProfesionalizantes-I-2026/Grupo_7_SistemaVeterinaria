meta {
  name: 5. Crear Turno - Fecha en el Pasado (400 Bad Request)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "2020-01-06T09:00:00Z",
    "motivoConsulta": "Intento de turno en el pasado"
  }
}
