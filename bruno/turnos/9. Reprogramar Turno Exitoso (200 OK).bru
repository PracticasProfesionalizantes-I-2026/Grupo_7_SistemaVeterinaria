meta {
  name: 9. Reprogramar Turno Exitoso (200 OK)
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/turnos/{{turnoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "fechaHora": "{{fechaTurnoReprogramado}}",
    "motivoConsulta": "ReprogramaciÃ³n autorizada por solicitud del dueÃ±o"
  }
}

script:pre-request {
  // Próximo martes a las 10:30 UTC (dentro de disponibilidad y libre)
  const ahora = new Date();
  const proximo = new Date(ahora.getTime());
  const diasHastaMartes = ((2 - ahora.getDay() + 7) % 7) || 7;
  proximo.setDate(ahora.getDate() + diasHastaMartes);
  proximo.setUTCHours(10, 30, 0, 0);
  bru.setEnvVar("fechaTurnoReprogramado", proximo.toISOString());
}
