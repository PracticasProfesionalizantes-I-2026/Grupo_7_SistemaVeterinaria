meta {
  name: 1. Obtener Agenda de Turnos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/turnos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

script:post-response {
  const data = res.getBody();
  if (Array.isArray(data) && data.length > 0) {
    bru.setEnvVar("turnoBaseId", data[0].id);
    const pendiente = data.find(t => t.estado === "Pendiente");
    if (pendiente) {
      bru.setEnvVar("turnoPendienteId", pendiente.id);
    }
    const enAtencion = data.find(t => t.estado === "EnAtencion");
    if (enAtencion) {
      bru.setEnvVar("turnoEnAtencionId", enAtencion.id);
    }
    const finalizado = data.find(t => t.estado === "Finalizado");
    if (finalizado) {
      bru.setEnvVar("turnoFinalizadoId", finalizado.id);
    }
  }
}
