meta {
  name: 0. Preparar - Configurar Disponibilidad Semanal (200 OK)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/turnos/disponibilidad/{{veterinarioId}}
  body: json
  auth: bearer
}

auth:bearer {
