meta {
  name: 3. Crear Turno Manual Exitoso (201 Created)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "{{fechaTurnoValido}}",
    "motivoConsulta": "Control clÃ­nico periÃ³dico programado"
  }
}

script:pre-request {
  // Calcular próximo lunes a las 09:00 UTC (siempre a futuro y dentro de disponibilidad)
  const ahora = new Date();
  const proximo = new Date(ahora.getTime());
  const diasHastaLunes = ((1 - ahora.getDay() + 7) % 7) || 7;
  proximo.setDate(ahora.getDate() + diasHastaLunes);
  proximo.setUTCHours(9, 0, 0, 0);
  bru.setEnvVar("fechaTurnoValido", proximo.toISOString());
}

script:post-response {
  const data = res.getBody();
  if (data && data.id) {
    bru.setEnvVar("turnoId", data.id);
  }
}
