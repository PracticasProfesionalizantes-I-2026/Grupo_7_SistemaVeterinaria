meta {
  name: 8. Crear Turno - Superposicion Horaria (409 Conflict - RN-08)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "mascotaId": "{{mascotaSinAtencionesId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "{{fechaTurnoValido}}",
    "motivoConsulta": "Intento de turno superpuesto en el mismo horario y profesional"
  }
}
