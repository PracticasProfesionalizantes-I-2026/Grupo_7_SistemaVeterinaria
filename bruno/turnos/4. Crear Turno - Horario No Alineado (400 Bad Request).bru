meta {
  name: 4. Crear Turno - Horario No Alineado (400 Bad Request)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "{{fechaTurnoNoAlineado}}",
    "motivoConsulta": "Intento de turno con minutos 15 (no alineado a bloque de 30)"
  }
}

script:pre-request {
  const ahora = new Date();
  const proximo = new Date(ahora.getTime());
  const diasHastaLunes = ((1 - ahora.getDay() + 7) % 7) || 7;
  proximo.setDate(ahora.getDate() + diasHastaLunes);
  proximo.setUTCHours(9, 15, 0, 0);
  bru.setEnvVar("fechaTurnoNoAlineado", proximo.toISOString());
}
