meta {
  name: 16. Acceso Denegado - Rol Administrador (403 Forbidden)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdministrador}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "{{fechaTurnoValido}}",
    "motivoConsulta": "Intento de agendar turno con rol no autorizado"
  }
}
