meta {
  name: 10. Reprogramar Turno - Turno Finalizado (409 Conflict - RN-09)
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/turnos/{{turnoFinalizadoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "fechaHora": "{{fechaTurnoReprogramado}}",
    "motivoConsulta": "Intento de modificar turno completado"
  }
}
