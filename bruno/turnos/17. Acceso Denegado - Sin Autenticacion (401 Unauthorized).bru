meta {
  name: 17. Acceso Denegado - Sin Autenticacion (401 Unauthorized)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/turnos
  body: json
  auth: none
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "veterinarioId": "{{veterinarioId}}",
    "fechaHora": "{{fechaTurnoValido}}",
    "motivoConsulta": "Intento de agendar turno sin credenciales"
  }
}
