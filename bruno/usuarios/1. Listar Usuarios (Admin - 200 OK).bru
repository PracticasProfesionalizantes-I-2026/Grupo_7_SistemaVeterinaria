meta {
  name: 1. Listar Usuarios (Admin - 200 OK)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/usuarios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdministrador}}
}

script:post-response {
  const usuarios = res.getBody();
  if (Array.isArray(usuarios) && usuarios.length > 0) {
    // Usuario general (primer resultado)
    bru.setEnvVar("usuarioId", usuarios[0].id);

    // Usuario activo no bloqueado
    const activo = usuarios.find(u => u.activo === true && u.bloqueado === false);
    if (activo) {
      bru.setEnvVar("usuarioActivoId", activo.id);
    }

    // Usuario bloqueado
    const bloqueado = usuarios.find(u => u.bloqueado === true);
    if (bloqueado) {
      bru.setEnvVar("usuarioBloqueadoId", bloqueado.id);
    }

    // Usuario inactivo
    const inactivo = usuarios.find(u => u.activo === false);
    if (inactivo) {
      bru.setEnvVar("usuarioInactivoId", inactivo.id);
    }

    // Usuario con password temporal
    const temporal = usuarios.find(u => u.requiereCambioPassword === true);
    if (temporal) {
      bru.setEnvVar("usuarioTemporalId", temporal.id);
    }
  }
}
