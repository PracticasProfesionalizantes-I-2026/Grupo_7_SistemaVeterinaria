meta {
  name: 6. Registrar Atención Vacuna NO APTO (409 Conflict - RN-03-04)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/atenciones-medicas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "motivoConsulta": "Vacunación anual",
    "anamnesis": "Propietario refiere decaimiento y lesiones dérmicas desde hace 48 horas.",
    "examenFisico": "Temperatura rectal 39.8°C, eritema y pústulas superficiales en región abdominal.",
    "diagnostico": "Cuadro febril e infección cutánea",
    "tratamiento": "Antibiótico y reposo",
    "pesoRegistrado": 28.0,
    "esAptoVacunacion": false,
    "vacunaAplicada": "Antirrábica Canina"
  }
}
