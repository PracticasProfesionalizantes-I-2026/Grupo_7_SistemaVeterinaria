meta {
  name: 10. Registrar Atención con Alerta Desnutrición (201 Created - RN-12)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/atenciones-medicas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

body:json {
  {
    "mascotaId": "{{mascotaAlertaId}}",
    "motivoConsulta": "Pérdida de peso progresiva y decaimiento",
    "anamnesis": "Propietario nota menor consumo de alimento seco desde hace tres semanas.",
    "examenFisico": "Condición corporal 2/5, costillas y crestas ilíacas fácilmente palpables.",
    "diagnostico": "Síndrome consuntivo en estudio / Hiporexia",
    "tratamiento": "Plan nutricional hipercalórico y antiparasitario",
    "pesoRegistrado": 17.00,
    "observaciones": "Se activa alerta clínica de desnutrición por pérdida del 15% respecto al peso de referencia (20.00 kg)."
  }
}
