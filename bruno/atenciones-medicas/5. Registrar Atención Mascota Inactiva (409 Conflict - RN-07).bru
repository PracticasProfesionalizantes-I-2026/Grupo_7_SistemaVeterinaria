meta {
  name: 5. Registrar Atención Mascota Inactiva (409 Conflict - RN-07)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/atenciones-medicas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

body:json {
  {
    "mascotaId": "{{mascotaInactivaId}}",
    "motivoConsulta": "Intento de atención médica",
    "anamnesis": "Propietario solicita control general.",
    "examenFisico": "Constantes vitales estables.",
    "diagnostico": "Revisión general",
    "tratamiento": "Ninguno",
    "pesoRegistrado": 32.0,
    "esAptoVacunacion": false
  }
}
