meta {
  name: 14. Registrar Atención - Sin Token (401 Unauthorized)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/atenciones-medicas
  body: json
  auth: none
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "motivoConsulta": "Intento anónimo",
