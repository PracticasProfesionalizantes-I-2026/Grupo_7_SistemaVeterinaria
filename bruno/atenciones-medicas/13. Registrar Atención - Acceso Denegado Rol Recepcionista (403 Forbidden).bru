meta {
  name: 13. Registrar Atención - Acceso Denegado Rol Recepcionista (403 Forbidden)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/atenciones-medicas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "motivoConsulta": "Intento de registro sin rol Veterinario",
    "anamnesis": "Evaluación inicial.",
    "examenFisico": "Parámetros normales.",
    "diagnostico": "N/A",
    "tratamiento": "N/A",
    "pesoRegistrado": 10.0
  }
}
