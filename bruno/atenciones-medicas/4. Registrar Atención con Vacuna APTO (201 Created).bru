meta {
  name: 4. Registrar Atención con Vacuna APTO (201 Created)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/atenciones-medicas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

body:json {
  {
    "mascotaId": "{{mascotaId}}",
    "motivoConsulta": "Control de rutina y vacunación",
    "anamnesis": "Paciente acude a control anual programado, apetito y ánimo conservados.",
    "examenFisico": "Mucosas rosadas, temperatura 38.5°C, frecuencia cardíaca y respiratoria dentro de parámetros normales.",
    "diagnostico": "Paciente clínicamente sano",
    "tratamiento": "Se aplica vacuna anual",
    "pesoRegistrado": 28.5,
    "esAptoVacunacion": true,
    "vacunaAplicada": "Antirrábica Canina",
    "observaciones": "Sin incidencias ni efectos adversos inmediatos."
  }
}
