meta {
  name: 1. Listar Atenciones Médicas
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/atenciones-medicas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

script:post-response {
  const atenciones = res.getBody();
  if (Array.isArray(atenciones) && atenciones.length > 0) {
    bru.setEnvVar("atencionId", atenciones[0].id);
  }
}
