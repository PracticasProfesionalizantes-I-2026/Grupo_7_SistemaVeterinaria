meta {
  name: 10. Reasignar Dueño - Mascota Inactiva (409 Conflict)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/mascotas/{{mascotaInactivaId}}/reasignar-dueno
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

body:json {
  {
    "nuevoDuenoId": "{{duenoId}}"
  }
}
