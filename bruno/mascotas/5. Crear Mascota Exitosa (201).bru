meta {
  name: 5. Crear Mascota Exitosa (201)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/mascotas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "duenoId": "{{duenoId}}",
    "nombre": "Violeta",
    "especie": "Perro",
    "raza": "Mestizo",
    "sexo": "Hembra",
    "fechaNacimiento": "2023-05-10T00:00:00Z",
    "peso": 12.50,
    "observaciones": "Paciente enérgico y saludable."
  }
}

script:post-response {
  // La mascota creada aquí es la que reasigna mascotas/9, para no alterar el dueño de {{mascotaId}}.
  const respuesta = res.getBody();
  if (respuesta && respuesta.id) {
    bru.setEnvVar("mascotaCreadaId", respuesta.id);
  }
}
