meta {
  name: 11. Reasignar Dueño - Mismo Dueño Actual (400 Bad Request)
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/mascotas/{{mascotaId}}/reasignar-dueno
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecepcionista}}
}

body:json {
  {
    "nuevoDuenoId": "{{mascotaDuenoId}}"
  }
}
