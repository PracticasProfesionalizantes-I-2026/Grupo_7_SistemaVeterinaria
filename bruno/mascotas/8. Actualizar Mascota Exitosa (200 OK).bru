meta {
  name: 8. Actualizar Mascota Exitosa (200 OK)
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/mascotas/{{mascotaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenVeterinario}}
}

body:json {
  {
    "nombre": "Thor Actualizado",
    "especie": "Perro",
    "raza": "Pastor Alemán Puro",
    "sexo": "Macho",
    "fechaNacimiento": "2020-05-15T00:00:00Z",
    "peso": 35.0,
    "observaciones": "Control de peso adecuado"
  }
}
