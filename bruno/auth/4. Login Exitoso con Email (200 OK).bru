script:post-response {
  // Se guarda en una variable separada: auth/13 cierra esta sesión y no debe revocar tokenAdministrador.
  const respuesta = res.getBody();
  if (respuesta && respuesta.token) {
    bru.setEnvVar("tokenSesionTemporal", respuesta.token);
  }
}
